{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "qiratperfumes",
          "appId": "1:530001069485:android:5e1891cec1ba894fb34d24",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "qiratperfumes",
          "configurations": {
            "android": "1:530001069485:android:5e1891cec1ba894fb34d24",
            "ios": "1:530001069485:ios:c9c74f7708e1cb54b34d24",
            "web": "1:530001069485:web:aea676ef6e1534c7b34d24"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "y",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "server/cashfree_function",
      "codebase": "cashfree",
      "runtime": "python313",
      "endpoints": {
        "cashfreeHttp": {
          "entryPoint": "cashfree_http",
          "region": "asia-south1",
          "httpsTrigger": {},
          "environmentVariables": {
            "CASHFREE_ENV": "SANDBOX",
            "CASHFREE_API_VERSION": "2025-01-01",
            "ALLOWED_ORIGIN": "*"
          },
          "secrets": ["CASHFREE_CLIENT_ID", "CASHFREE_CLIENT_SECRET"]
        }
      }
    }
  ]
}
